generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  CASHIER
  ACCOUNTANT
  MANAGER
  ADMIN
  DRIVER
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  /** Manager/Admin PIN for POS overrides (e.g. "1234"). */
  pinCode   String?
  role      Role     @default(CASHIER)
  /** ACTIVE | SUSPENDED — suspended users cannot log in. */
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts Shift[]
  inventoryAdjustments InventoryAdjustment[]
  sales Sale[]
  auditLogs AuditLog[]
  driverExpenses DriverExpense[] @relation("DriverExpenses")
  reviewedDriverExpenses DriverExpense[] @relation("DriverExpenseReviewer")
}

/// Immutable activity log for accountability (who did what).
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([entity])
}

/// Local ERP product catalog — synced from WooCommerce (Arabic).
model Product {
  id            String   @id @default(cuid())
  wcId          Int      @unique
  name          String
  nameEn        String?
  nameZh        String?
  sku           String?
  barcode       String?
  price         Float
  salePrice     Float?
  stockQuantity Int      @default(0)
  stockStatus   String   @default("instock")
  /** Pieces in one supplier carton/box. Purchase qty is packs; stock is qty × this. */
  purchasePackSize Int   @default(1)
  /** Last piece cost recorded by an opening-balance entry. */
  buyingCost       Float @default(0)
  imageUrl      String?
  isDeleted     Boolean  @default(false)
  isFavorite    Boolean  @default(false)
  /** Virtual bundle: base single-unit product this pack sells from. */
  linkedProductId  String?
  /** How many base units one sold bundle consumes (e.g. 3). */
  bundleMultiplier Int?
  /** Optional department. Existing products stay uncategorized. */
  categoryId       String?
  /** Optional brand. Existing products stay unbranded. */
  brandId          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category        Category? @relation(fields: [categoryId], references: [id])
  brand           Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  linkedProduct   Product?  @relation("ProductToBundle", fields: [linkedProductId], references: [id])
  virtualBundles  Product[] @relation("ProductToBundle")

  purchaseItems       PurchaseInvoiceItem[]
  purchaseReturns     PurchaseReturnItem[]
  adjustmentItems     AdjustmentItem[]
  saleLines           SaleLine[]
  openingBalanceItems OpeningBalanceItem[]
  orderItems          OrderItem[]

  @@index([barcode])
  @@index([sku])
  @@index([name])
  @@index([isDeleted])
  @@index([isFavorite])
  @@index([linkedProductId])
  @@index([categoryId])
  @@index([brandId])
}

model Supplier {
  id             Int      @id @default(autoincrement())
  name           String
  phone          String?
  /** Live A/P total owed (includes openingBalance + purchases − payments − returns). */
  balance        Float    @default(0)
  /** Prior debt from old system (أرصدة افتتاحية). Admin-managed. */
  openingBalance Float    @default(0)
  /** How much of openingBalance has been paid off via supplier payments. */
  paidOpeningBalance Float @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices PurchaseInvoice[]
  payments SupplierPayment[]
  returns  PurchaseReturn[]
}

model PurchaseInvoice {
  id            Int      @id @default(autoincrement())
  invoiceNumber String?
  date          DateTime @default(now())
  supplierId    Int
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  totalAmount   Float
  paidAmount    Float    @default(0)
  /** PAID | PARTIAL | UNPAID */
  status        String   @default("UNPAID")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items PurchaseInvoiceItem[]

  @@index([supplierId])
  @@index([date])
  @@index([status])
}

model PurchaseInvoiceItem {
  id        Int             @id @default(autoincrement())
  invoiceId Int
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Local Prisma Product.id (cuid) — not WooCommerce Int id.
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  quantity  Int
  unitCost  Float
  lineTotal Float

  @@index([invoiceId])
  @@index([productId])
}

model SupplierPayment {
  id         Int      @id @default(autoincrement())
  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  amount     Float
  date       DateTime @default(now())
  notes      String?
  /** null = paid from physical Treasury cash safe */
  bankAccountId Int?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([supplierId])
  @@index([date])
  @@index([bankAccountId])
}

model PurchaseReturn {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  supplierId  Int
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  totalAmount Float
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items PurchaseReturnItem[]

  @@index([supplierId])
  @@index([date])
}

model PurchaseReturnItem {
  id        Int           @id @default(autoincrement())
  returnId  Int
  return    PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  /// Local Prisma Product.id (cuid) — not WooCommerce Int id.
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Int
  unitCost  Float
  lineTotal Float

  @@index([returnId])
  @@index([productId])
}

/// Master safe / cash drawer — singleton row with id = 1.
model Treasury {
  id        Int      @id @default(1)
  balance   Float    @default(0)
  updatedAt DateTime @updatedAt
}

model TreasuryTransaction {
  id          Int      @id @default(autoincrement())
  /** IN | OUT */
  type        String
  amount      Float
  description String
  /** e.g. EXPENSE, SUPPLIER_PAY, POS_SHIFT */
  reference   String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([type])
  @@index([reference])
}

model ExpenseCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]
}

model Expense {
  id         Int             @id @default(autoincrement())
  categoryId Int
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount     Float
  date       DateTime        @default(now())
  notes      String?
  /** null = paid from physical Treasury cash safe */
  bankAccountId Int?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([categoryId])
  @@index([date])
  @@index([bankAccountId])
}

/// Digital / bank channel balances (Visa, Wallet, InstaPay, WeChat, …).
model BankAccount {
  id        Int      @id @default(autoincrement())
  name      String
  /** Stable key for POS routing: visa | wallet | instapay | wechat */
  code      String   @unique
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions BankTransaction[]
  expenses     Expense[]
  supplierPayments SupplierPayment[]
}

model BankTransaction {
  id        Int         @id @default(autoincrement())
  accountId Int
  account   BankAccount @relation(fields: [accountId], references: [id])
  /** IN | OUT */
  type      String
  amount    Float
  reference String
  date      DateTime    @default(now())
  createdAt DateTime    @default(now())

  @@index([accountId])
  @@index([date])
  @@index([type])
  @@index([reference])
}

/// Move funds between Treasury cash and bank accounts (or bank ↔ bank).
model InternalTransfer {
  id            Int      @id @default(autoincrement())
  /** TREASURY | BANK */
  fromType      String
  fromAccountId Int?
  /** TREASURY | BANK */
  toType        String
  toAccountId   Int?
  amount        Float
  date          DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([date])
  @@index([fromType])
  @@index([toType])
}

/// POS cashier shift — cash drawer float + Z-report close into Treasury.
model Shift {
  id             Int       @id @default(autoincrement())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  startTime      DateTime  @default(now())
  endTime        DateTime?
  startingCash   Float
  cashSales      Float     @default(0)
  visaSales      Float     @default(0)
  walletSales    Float     @default(0)
  instapaySales  Float     @default(0)
  wechatSales    Float     @default(0)
  /** Total completed tickets (sales + returns) this shift. */
  tickets        Int       @default(0)
  actualCash     Float?
  variance       Float?
  /** OPEN | CLOSED */
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, status])
  @@index([status])
}

/// Stock reconciliation / wastage / production use.
model InventoryAdjustment {
  id        Int      @id @default(autoincrement())
  date      DateTime @default(now())
  /** WASTAGE | LOSS | PRODUCTION_USE | MANUAL_COUNT */
  type      String
  notes     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items AdjustmentItem[]

  @@index([date])
  @@index([type])
  @@index([userId])
}

model AdjustmentItem {
  id             Int                 @id @default(autoincrement())
  adjustmentId   Int
  adjustment     InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  /** Local Prisma Product.id (cuid) */
  productId      String
  product        Product             @relation(fields: [productId], references: [id])
  /** Delta applied to stockQuantity (negative removes stock). */
  quantityChange Int
  unitCost       Float
  createdAt      DateTime            @default(now())

  @@index([adjustmentId])
  @@index([productId])
}

model OpeningBalance {
  id        Int      @id @default(autoincrement())
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())

  items OpeningBalanceItem[]

  @@index([date])
}

model OpeningBalanceItem {
  id               Int            @id @default(autoincrement())
  openingBalanceId Int
  openingBalance   OpeningBalance @relation(fields: [openingBalanceId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  packQty          Int
  packSize         Int
  looseQty         Int
  pieceCost        Float
  totalStock       Int
  totalValue       Float
  createdAt        DateTime       @default(now())

  @@index([openingBalanceId])
  @@index([productId])
}

/// Staff who can receive an internal meal (وجبات عمال). Not a login account.
model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  sales Sale[]

  @@index([isActive])
}

/// Completed POS sale / return — source of truth for Reports P&L and bestsellers.
model Sale {
  id            String   @id @default(cuid())
  /** IndexedDB local sale id (for idempotent sync). */
  localId       String?  @unique
  shiftId       Int?
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  total         Float
  /** cash | visa | wallet | instapay | wechat | STAFF_MEAL */
  paymentMethod String
  /** Set when paymentMethod is STAFF_MEAL (وجبات عمال). */
  employeeId    Int?
  employee      Employee? @relation(fields: [employeeId], references: [id])
  isReturn      Boolean  @default(false)
  /** completed */
  status        String   @default("completed")
  wooOrderId    Int?
  customerName  String?
  /** Set when the sale was saved despite a business-rule issue (oversell, no shift). */
  requiresAudit Boolean  @default(false)
  auditReason   String?
  createdAt     DateTime @default(now())

  lines SaleLine[]

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@index([isReturn])
  @@index([employeeId])
}

model SaleLine {
  id          Int     @id @default(autoincrement())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  /** Local Prisma Product.id when known */
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  /** WooCommerce product id from POS cart */
  wcProductId Int?
  name        String
  quantity    Int
  unitPrice   Float
  /** Snapshot cost for COGS at time of sale */
  unitCost    Float   @default(0)
  lineTotal   Float

  @@index([saleId])
  @@index([productId])
  @@index([wcProductId])
}

model Brand {
  id        String    @id @default(cuid())
  /** Arabic brand name. */
  name      String    @unique
  nameEn    String?
  nameZh    String?
  /** Optional logo URL or local upload path. */
  image     String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  /** Arabic department name (مثل: مكرونات، جبن، عصائر). */
  name        String    @unique
  nameEn      String?
  nameZh      String?
  /** English website slug (مثل: pastas). */
  slug        String    @unique
  description String?
  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Customer {
  id            String   @id @default(uuid())
  /** Primary login identifier. */
  phone         String   @unique
  name          String?
  /** Optional password for standard login. */
  password      String?
  pointsBalance Int      @default(0)
  /** Expo push token from the mobile app (ExponentPushToken[…]). */
  expoPushToken String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pointsTransactions PointsTransaction[]
  orders             Order[]
}

model PointsTransaction {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  /** Positive when earning, negative when redeeming. */
  points      Int
  /** EARN | REDEEM */
  type        String
  description String?
  createdAt   DateTime @default(now())

  @@index([customerId])
}

model Order {
  id             String      @id @default(cuid())
  customerName   String
  phone          String
  address        String
  notes          String?
  totalAmount    Float
  status         String      @default("PENDING")
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id])
  pointsEarned   Int?
  pointsRedeemed Int?
  createdAt      DateTime    @default(now())
  items          OrderItem[]

  @@index([customerId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

/// Driver-submitted fleet expense (fuel, toll, oil, maintenance).
model DriverExpense {
  id             String   @id @default(cuid())
  driverId       String
  driver         User     @relation("DriverExpenses", fields: [driverId], references: [id])
  /** FUEL | TOLL | OIL | MAINTENANCE */
  category       String
  amount         Float
  /** Amount accepted by admin (may differ on PARTIAL). */
  approvedAmount Float?
  /** PENDING | APPROVED | PARTIAL | REJECTED */
  status         String   @default("PENDING")
  adminNotes     String?
  odometerImage  String?
  pumpImage      String?
  receiptImage   String?
  tollImage      String?
  /** Linked row in main Expense table after approval. */
  linkedExpenseId Int?
  reviewedById   String?
  reviewedBy     User?    @relation("DriverExpenseReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([driverId])
  @@index([status])
  @@index([createdAt])
  @@index([linkedExpenseId])
}
