# WooCommerce REST API credentials
# Generate keys in WooCommerce > Settings > Advanced > REST API

WOOCOMMERCE_URL=https://your-store.example.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret

# WordPress Application Password — required for product image uploads
# (Users → Profile → Application Passwords). Used by /wp-json/wp/v2/media.
WORDPRESS_USERNAME=your_wp_username
WORDPRESS_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Local SQLite (Prisma) — separate from WooCommerce
DATABASE_URL="file:./dev.db"

# Shared secret the storefront sends as the x-api-key header on POST /api/store/orders
STORE_API_KEY="replace-with-a-long-random-secret"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Optional in local dev:
# AUTH_TRUST_HOST=true
